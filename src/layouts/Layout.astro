---
import '../styles/global.css'
import Navbar from '../components/Navbar.astro'

interface Props {
	title?: string;
	description?: string;
	pageType?: 'website' | 'article';
}

const {
	title = 'SEC-Hub | Systems engineering software solution',
	description = 'SEC-Hub is a systems engineering software platform for modelling, structuring and collaborating on complex systems using the ISO/IEC 81346 standard.',
	pageType = 'website',
} = Astro.props;

const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const socialImage = new URL('/social-card.png', Astro.site).href;
const socialImageAlt = 'SEC-Hub logo and wordmark with the text "Systems engineering software"';
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta
			name="description"
			content={description}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta property="og:site_name" content="SEC-Hub" />
		<meta property="og:type" content={pageType} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={pageUrl} />
		<meta property="og:image" content={socialImage} />
		<meta property="og:image:alt" content={socialImageAlt} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<script is:inline type="speculationrules">
			{ "prerender": [{ "where": { "href_matches": "/*" }, "eagerness": "moderate" }] }
		</script>
	</head>
	<body>
		<Navbar /> 
		<slot />
		<footer class="border-t border-primary/10 bg-slate-50">
			<div class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-4 px-6 py-8 text-sm md:flex-row md:px-10">
				<p class="text-slate-600">© Systems Engineering A/S</p>
				<nav aria-label="Footer" class="flex flex-wrap justify-center gap-x-6 gap-y-3">
					<a
						href="https://81346.com/"
						class="font-medium text-primary underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
					>
						81346.com
					</a>
					<a
						href="https://systemsengineeringconcept.com/"
						class="font-medium text-primary underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
					>
						Systems Engineering Concept
					</a>
				</nav>
			</div>
		</footer>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
