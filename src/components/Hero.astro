---
import HeroVector from './vectors/Hero.astro';

// Update the title and link here to highlight a different news article.
const featuredNews = {
	title: 'Chain Analysis',
	href: '/new/chain-analysis-feature/',
};
---

	<main>
		<section class="relative mx-auto grid min-h-[80vh] max-w-7xl items-center gap-12 px-6 py-16 md:grid-cols-2 md:px-10 md:pb-32">
			<div>
				<h1 class="text-4xl font-semibold text-primary sm:text-5xl">Built for systems engineering</h1>
				<p class="mt-6 max-w-xl text-lg leading-8 text-slate-600">
					Model, structure and collaborate on complex engineering systems in
					one shared workspace. SEC-Hub brings reference designations,
					object structures, interfaces and project context together.
				</p>
				<div class="mt-8 flex flex-wrap gap-3">
					<a
						href="/contact/"
						class="rounded-md bg-primary px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-primary/90 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
					>
						Request a demo
					</a>
					<a
						href="https://app.sec-hub.com"
						class="rounded-md border border-slate-300 px-5 py-3 text-sm font-semibold text-slate-700 transition-colors hover:border-slate-400 hover:bg-slate-50 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
					>
						Log in
					</a>
				</div>
			</div>
			<div
				class="w-full [&>svg]:h-auto [&>svg]:w-full"
				role="img"
				aria-label="SEC-Hub functional structure and interface matrix"
			>
				<HeroVector />
			</div>
			<a
				href={featuredNews.href}
				class="group flex max-w-full items-center gap-3 justify-self-end rounded-full border border-primary/10 bg-white py-2 pr-4 pl-2 text-sm text-primary shadow-sm transition-colors hover:border-accent/50 hover:bg-accent/5 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary md:absolute md:right-10 md:bottom-8 md:max-w-[calc(100%-5rem)]"
			>
				<span class="shrink-0 rounded-full bg-accent px-3 py-1 text-xs font-bold uppercase tracking-wide text-primary">New</span>
				<span class="min-w-0 font-medium">{featuredNews.title}</span>
				<svg class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
					<path d="M5 12h14m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
				</svg>
			</a>
		</section>
	</main>
