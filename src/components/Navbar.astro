
---
import { Image } from 'astro:assets';
---
<nav aria-label="Main navigation" class="sticky top-0 z-20 bg-white/90 backdrop-blur-sm">
	<div class="mx-auto grid max-w-7xl grid-cols-[1fr_auto] items-center gap-x-6 gap-y-4 px-6 py-4 md:px-10">
		<a
			href="/"
			aria-label="SEC-Hub home"
			class="flex w-fit items-center gap-3 rounded-md text-xl font-semibold tracking-tight text-primary focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
		>
			<Image src="/favicon.svg" alt="" width={36} height={36} loading="eager" />
			<span>SEC-Hub</span>
		</a>

		<div class="col-span-2 row-start-2 flex flex-wrap items-center justify-end gap-x-5 gap-y-3 md:col-span-1 md:col-start-2 md:row-start-1">
			<ul class="flex flex-wrap items-center justify-end gap-x-5 gap-y-2 text-sm font-medium text-slate-600 md:gap-x-8">
				<li>
					<a
						href="/pricing/"
						aria-current={Astro.url.pathname.startsWith('/pricing') ? 'page' : undefined}
						class="rounded-sm transition-colors hover:text-primary aria-[current=page]:text-primary focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
					>
						Pricing
					</a>
				</li>
				<li>
					<a
						href="/new/"
						aria-current={Astro.url.pathname.startsWith('/new/') ? 'page' : undefined}
						class="rounded-sm transition-colors hover:text-primary aria-[current=page]:text-primary focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
					>
						New
					</a>
				</li>
				<li>
					<a
						href="/contact/"
						aria-current={Astro.url.pathname.startsWith('/contact') ? 'page' : undefined}
						class="rounded-sm transition-colors hover:text-primary aria-[current=page]:text-primary focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
					>
						Contact
					</a>
				</li>
			</ul>

			<a
				href="https://app.sec-hub.com"
				class="rounded-md bg-primary px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-primary/90 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
			>
				Log in
			</a>
		</div>
	</div>
</nav>