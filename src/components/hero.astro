---
import { Image } from "astro:assets"
import heroImage from "@/assets/hero.png"
import HeroButtons from "@/components/ui/hero-buttons"
---

<section class="relative min-h-screen overflow-hidden bg-background">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center min-h-screen py-12">
      {/* Content */}
      <div class="flex flex-col justify-center space-y-8">
        <div>
          <h1 class="text-5xl sm:text-6xl font-bold tracking-tight mb-6">
            Built for systems engineering
          </h1>
          <p class="text-xl text-muted-foreground leading-relaxed mb-8">
            Model, structure and collaborate on complex engineering systems in
            one shared workspace. SEC-Hub brings reference designations,
            object structures, interfaces and project context together.
          </p>
        </div>

        <HeroButtons />
      </div>

      {/* Image */}
      <div class="relative flex items-center justify-center">
        <div class="relative w-full">
          <Image
            src={heroImage}
            alt="SEC-Hub systems engineering platform"
            class="w-full h-auto rounded-lg"
          />
        </div>
      </div>
    </div>
  </div>
</section>
