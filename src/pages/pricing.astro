---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="Pricing | SEC-Hub"
	description="SEC-Hub pricing is scoped to your organisation's users, projects, workspaces, data volume, integrations and support needs."
>
	<main>
		<section class="bg-slate-50">
			<div class="mx-auto max-w-7xl px-6 py-16 md:px-10 md:py-24">
				<p class="text-sm font-semibold uppercase tracking-wide text-orange-700">Pricing</p>
				<h1 class="mt-4 max-w-3xl text-4xl font-semibold tracking-tight text-slate-950 sm:text-5xl">
					Pricing that follows your project setup
				</h1>
				<p class="mt-6 max-w-2xl text-lg leading-8 text-slate-600">
					SEC-Hub is used in B2B engineering environments where access,
					onboarding and integrations often differ from project to project.
					We keep pricing simple and scope it together with your team.
				</p>
			</div>
		</section>

		<section aria-labelledby="pricing-details-title" class="mx-auto grid max-w-7xl gap-12 px-6 py-16 md:px-10 md:py-20 lg:grid-cols-[minmax(0,1fr)_20rem] lg:gap-20">
			<div>
				<h2 id="pricing-details-title" class="text-2xl font-semibold text-slate-950 sm:text-3xl">
					Talk to us about your organisation
				</h2>
				<p class="mt-5 max-w-2xl text-lg leading-8 text-slate-600">
					We will help you find the right setup based on users, projects,
					workspaces, data volume, integrations and support needs.
				</p>
				<ul class="mt-8 grid gap-4 sm:grid-cols-2">
					<li class="rounded-lg border border-slate-200 bg-white p-5 text-sm font-medium text-slate-800">
						Users and roles
					</li>
					<li class="rounded-lg border border-slate-200 bg-white p-5 text-sm font-medium text-slate-800">
						Project and context setup
					</li>
					<li class="rounded-lg border border-slate-200 bg-white p-5 text-sm font-medium text-slate-800">
						API and integration needs
					</li>
					<li class="rounded-lg border border-slate-200 bg-white p-5 text-sm font-medium text-slate-800">
						Onboarding and support
					</li>
				</ul>
			</div>

			<aside class="h-fit rounded-lg border border-slate-200 bg-slate-50 p-6 sm:p-8">
				<h2 class="text-lg font-semibold text-slate-950">Let’s find the right fit</h2>
				<p class="mt-3 text-sm leading-6 text-slate-600">
					Email us about your team and project setup. We’ll work with you to understand
					what you need and scope the right pricing for your organisation.
				</p>
				<a
					href="/contact/"
					class="mt-6 inline-flex rounded-md bg-slate-950 px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-slate-800 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-slate-950"
				>
					Contact our team
				</a>
				<p class="mt-3 text-sm leading-6 text-slate-500">
					Visit our contact page for our email address or to request a demo.
				</p>
			</aside>
		</section>
	</main>
</Layout>
