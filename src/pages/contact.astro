---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="Contact | SEC-Hub"
	description="Get in touch with the SEC-Hub team to learn more about the systems engineering workspace."
>
	<main>
		<section class="bg-slate-50">
			<div class="mx-auto max-w-7xl px-6 py-16 md:px-10 md:py-24">
				<p class="text-sm font-semibold uppercase tracking-wide text-orange-700">Contact SEC-Hub</p>
				<h1 class="mt-4 max-w-3xl text-4xl font-semibold tracking-tight text-slate-950 sm:text-5xl">
					Let’s talk about your systems engineering work
				</h1>
				<p class="mt-6 max-w-2xl text-lg leading-8 text-slate-600">
					Have a question, want to explore the workspace, or interested in a demo?
					Send us a note and we’ll be happy to start a conversation.
				</p>
			</div>
		</section>

		<section aria-label="Contact form" class="mx-auto grid max-w-7xl gap-12 px-6 py-16 md:px-10 md:py-20 lg:grid-cols-[minmax(0,1fr)_20rem] lg:gap-20">
			<form class="space-y-6">
				<div class="grid gap-6 sm:grid-cols-2">
					<div>
						<label for="name" class="block text-sm font-medium text-slate-700">Name</label>
						<input
							id="name"
							name="name"
							type="text"
							autocomplete="name"
							placeholder="Your name"
							class="mt-2 block w-full rounded-md border border-slate-300 bg-white px-3 py-2.5 text-slate-950 placeholder:text-slate-400 focus:border-slate-500 focus:outline-2 focus:outline-offset-2 focus:outline-slate-700"
						/>
					</div>
					<div>
						<label for="email" class="block text-sm font-medium text-slate-700">Work email</label>
						<input
							id="email"
							name="email"
							type="email"
							autocomplete="email"
							placeholder="you@company.com"
							class="mt-2 block w-full rounded-md border border-slate-300 bg-white px-3 py-2.5 text-slate-950 placeholder:text-slate-400 focus:border-slate-500 focus:outline-2 focus:outline-offset-2 focus:outline-slate-700"
						/>
					</div>
				</div>

				<div>
					<label for="subject" class="block text-sm font-medium text-slate-700">What would you like to discuss?</label>
					<select
						id="subject"
						name="subject"
						class="mt-2 block w-full rounded-md border border-slate-300 bg-white px-3 py-2.5 text-slate-950 focus:border-slate-500 focus:outline-2 focus:outline-offset-2 focus:outline-slate-700"
					>
						<option>Request a demo</option>
						<option>Product question</option>
						<option>Something else</option>
					</select>
				</div>

				<div>
					<label for="message" class="block text-sm font-medium text-slate-700">Message</label>
					<textarea
						id="message"
						name="message"
						rows="5"
						placeholder="Tell us a little about what you’re looking for..."
						class="mt-2 block w-full resize-y rounded-md border border-slate-300 bg-white px-3 py-2.5 text-slate-950 placeholder:text-slate-400 focus:border-slate-500 focus:outline-2 focus:outline-offset-2 focus:outline-slate-700"
					></textarea>
				</div>

				<button
					type="button"
					class="rounded-md bg-slate-950 px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-slate-800 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-slate-950"
				>
					Send message
				</button>
				<p class="text-sm text-slate-500">This is a demo form and does not send messages.</p>
			</form>

			<aside class="h-fit rounded-lg border border-slate-200 bg-slate-50 p-6 sm:p-8">
				<h2 class="text-lg font-semibold text-slate-950">A shared view of complex systems</h2>
				<p class="mt-3 text-sm leading-6 text-slate-600">
					Whether you’re exploring SEC-Hub for a project or just have a question, tell us what your team is working on.
				</p>
				<div class="mt-6 border-t border-slate-200 pt-6">
					<p class="text-sm font-medium text-slate-950">Interested in a walkthrough?</p>
					<p class="mt-2 text-sm leading-6 text-slate-600">
						Choose “Request a demo” above and let us know what you’d like to see.
					</p>
				</div>
			</aside>
		</section>
	</main>
</Layout>
