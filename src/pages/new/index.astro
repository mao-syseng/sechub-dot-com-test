---
import { getCollection } from 'astro:content';
import ArticleList from '../../components/NewsList.astro';
import Layout from '../../layouts/Layout.astro';

const posts = await getCollection('updates', ({ data }) => !data.draft);
---

<Layout title="Now | SEC-Hub" description="The latest articles, ideas, and updates from SEC-Hub.">
	<main class="mx-auto max-w-7xl px-6 py-16 md:px-10 md:py-24">
		<header class="max-w-2xl">

			<h1 class="mt-4 text-4xl font-semibold tracking-tight text-slate-950 md:text-6xl">New</h1>
			<p class="mt-6 text-lg leading-8 text-slate-600">Articles, ideas, and updates on building a shared understanding of complex systems.</p>
		</header>

		<ArticleList posts={posts} />
	</main>
</Layout>
