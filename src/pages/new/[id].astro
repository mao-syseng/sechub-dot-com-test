
---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import ArticleTags from '../../components/ArticleTags.astro';
import Layout from '../../layouts/Layout.astro';

interface Props {
  post: CollectionEntry<'updates'>;
}

export async function getStaticPaths() {
  const posts = await getCollection(
    'updates',
    ({ data }) => !data.draft
  );

  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const publishedAt = new Intl.DateTimeFormat('en', {
  dateStyle: 'long',
  timeZone: 'UTC',
}).format(post.data.publishedAt);
---

<Layout title={`${post.data.title} | SEC-Hub`} description={post.data.description}>
  <main class="mx-auto max-w-3xl px-6 py-16 md:py-24">
    <a href="/new/" class="rounded-sm text-sm font-medium text-slate-600 underline underline-offset-4 hover:text-slate-950 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-slate-950">Back to all articles</a>
    <article class="mt-10">
      <header>
        <div class="flex flex-wrap gap-x-4 gap-y-2 text-sm text-slate-500">
          <span>{post.data.category}</span>
          <time datetime={post.data.publishedAt.toISOString()}>{publishedAt}</time>
        </div>
        <h1 class="mt-4 text-4xl font-semibold tracking-tight text-slate-950 md:text-5xl">{post.data.title}</h1>
        <p class="mt-6 text-lg leading-8 text-slate-600">{post.data.description}</p>
        <ArticleTags tags={post.data.tags} />
      </header>

      <div class="article-content mt-10 border-t border-slate-200 pt-8 text-lg leading-8 text-slate-700">
        <Content />
      </div>
    </article>
  </main>
</Layout>

<style>
  .article-content :global(h2) {
    margin: 2rem 0 1rem;
    color: var(--color-slate-950);
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .article-content :global(p),
  .article-content :global(ul),
  .article-content :global(ol) {
    margin-bottom: 1.5rem;
  }

  .article-content :global(ul) {
    list-style: disc;
    padding-left: 1.5rem;
  }

  .article-content :global(ol) {
    list-style: decimal;
    padding-left: 1.5rem;
  }

  .article-content :global(a) {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
